# --- Destination configuration for hybrid testing of OnPremise destinations --- #
destinations='[{"name": "<DEST_NAME>","url": "https://<DEST_NAME>.dest","proxyHost": "http://127.0.0.1","proxyPort": "8887"}]'
# --- IAS user credentials for principal propagation testing (btp.http) ---
# Used by the REST Client $dotenv variable in test/btp.http to obtain a
# user-specific JWT via the IAS password (ROPC) grant. Never commit real values.
IAS_USERNAME=<username>
IAS_PASSWORD=<password>