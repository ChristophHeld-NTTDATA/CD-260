@server=http://localhost:4004

### All flavours
GET {{server}}/odata/v4/icecream/Flavours

### All orders
GET {{server}}/odata/v4/icecream/Orders

### Top 3 flavours by scoops sold
GET {{server}}/odata/v4/icecream/Orders?$apply=groupby((flavour_ID),aggregate(scoops with sum as totalScoops))&$orderby=totalScoops desc&$top=3

### Create a new flavour
POST {{server}}/odata/v4/icecream/Flavours
Content-Type: application/json

{
  "ID": 11,
  "name": "Blueberry Cheesecake",
  "category": "fruity",
  "colour": "purple",
  "pricePerScoop": 2.7,
  "vegan": false,
  "stock": 20,
  "rating": 4
}

### Change the stock of a flavour
PATCH {{server}}/odata/v4/icecream/Flavours(11)
Content-Type: application/json

{
  "stock": 5
}

### Delete a flavour
DELETE {{server}}/odata/v4/icecream/Flavours(11)

### Order an ice cream (creates an order and reduces the stock)
GET {{server}}/odata/v4/icecream/orderIceCream(flavour=2,customerName='Tom',scoops=2)
